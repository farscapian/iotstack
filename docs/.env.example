# iotstack Environment Configuration Template
#
# Copy this to ~/.iotstack/.env to customize for your setup
# Or create alternate configs: cp .env.example ~/.iotstack/myconfig.env
# Then use: iotstack -env=myconfig.env flash ...

# Force recompilation of firmware on every build (disables compilation cache)
# Useful for debugging build issues or ensuring fresh compilation
# Values: 0 (default, use cache) or 1 (always recompile)
DISABLE_COMPILATION_CACHE=0

# Clean entire build directory before compiling
# Useful for debugging build issues or forcing full recompilation
# Values: 0 (default, keep build artifacts) or 1 (remove ESPHOME_BUILD_DIR)
CLEAN_BUILD_DIRECTORY=0
