# iotstack Environment Configuration Template
#
# Copy this to ~/.iotstack/environments/default.env to customize for your setup
# Or create alternate configs: cp .env.example ~/.iotstack/environments/myconfig.env
# Then use: iotstack -env=myconfig.env flash ...

# Clean entire build directory before compiling
# Useful for debugging build issues or forcing full recompilation
# Values: 0 (default, keep build artifacts) or 1 (remove ESPHOME_BUILD_DIR)
CLEAN_BUILD_DIRECTORY=0

# Auto-register production devices in Home Assistant after flash/update (0=off, 1=on)
# Uses the device-specific api_encryption_key (derived from pass + MAC) via WebSocket.
PERFORM_HA_DEVICE_REGISTRATION=0

# Compile production firmware with an opt-in OTA endpoint so `iotstack
# ota-bootstrap` can push a new bootstrap image to fielded devices without a
# USB trip (0=off, 1=on). Bootstrap is the fleet's only recovery floor with
# no boot-health watchdog yet -- read docs/features.md and
# docs/boot-fallback.md before enabling. Off by default: production firmware
# then has no OTA server at all, same as today.
IOTSTACK_ENABLE_BOOTSTRAP_OTA=0

# Bootstrap partition role name (hostnames, mDNS, pass store, partition label)
# Default: bootstrap. Changing this requires re-flashing all devices.
# IOTSTACK_BOOTSTRAP_ROLE=bootstrap

# Integration test runner (iotstack tests run)
# Ports are auto-detected via esptool chip-id; override only if needed:
# IOTSTACK_TEST_TTY_C6=/dev/ttyACM0
# IOTSTACK_TEST_TTY_S3=/dev/ttyACM1

# =============================================================================
# OTBR (OpenThread Border Router) -- iotstack otbr ...
# =============================================================================
#
# WiFi and Thread network secrets are NOT set here -- they live in the pass
# store, seeded (as CONFIGURE_ME placeholders) by setup.sh and namespaced by
# the active -env= environment. Set them with:
#   pass edit iotstack/default/common/wifi_ssid
#   pass edit iotstack/default/common/wifi_password
#   pass edit iotstack/default/common/thread_tlv
# (generate a Thread dataset with: ot-ctl dataset init new && ot-ctl dataset
# active -x, or export one from an existing commissioner). Any of the
# settings below can also be overridden by exporting the same variable in
# your shell before running iotstack.

# Device hostname written into cloud-init meta-data (iotstack otbr flash).
# Used for the Pi's /etc/hostname, mDNS name (<hostname>.local), and SSH config stub.
# OTBR_HOSTNAME=otbr-raspi4

# Deploy python-matter-server on the device (WebSocket Matter controller, port 5580).
# Set to 0 to skip installation.
# DEPLOY_MATTER_SERVER=1

# SSH public key injected into the Pi image via cloud-init (iotstack otbr flash).
# SSH_PUBKEY=""

# UFW: space-separated list of CIDRs allowed to SSH into the device.
# Use /32 for individual hosts, or a subnet like 192.168.4.0/24.
# Leave empty to allow SSH from anywhere (not recommended for production).
# SSH_MGMT_CIDRS=""

# Snap channels (openthread-border-router is not on stable; use edge or beta).
# OTBR_SNAP_CHANNEL=latest/edge
# CHIP_TOOL_SNAP_CHANNEL=latest/stable

# Development / performance options (iotstack otbr flash)
# SKIP_IMAGE_VERIFICATION=0   # skip SHA-256 verification of the downloaded Ubuntu image
# PULL_LATEST_REPOS=1         # 1 = use cached source as-is, skip git clone/fetch/pull
# SKIP_RCP_VERIFY=0           # skip RCP Spinel firmware verification during first-boot
# SKIP_CHROOT=0               # skip the arm64 chroot (defers apt work to first-boot on the Pi)

# All iotstack otbr provisioners (vm, flash, docker, snap): when pass holds a real
# ha_url and ha_token, the Thread dataset is checked against Home Assistant's
# before provisioning, and a mismatch aborts. 1 = skip that check.
# SKIP_HA_THREAD_VERIFY=0

# Optional HTTP/HTTPS proxy (e.g. a local Squid cache) for otbr provisioning.
# HTTP_PROXY="http://squid.local:3128"

# Home Assistant MQTT Discovery (optional). When MQTT_BROKER is set, the OTBR
# Pi registers with HA automatically via MQTT Discovery: restart/shutdown
# buttons, OTBR agent status, Thread role, uptime. Requires the HA Mosquitto
# add-on or an external MQTT broker.
# MQTT_BROKER=""
# MQTT_PORT=1883
# MQTT_USER=""
# MQTT_PASSWORD=""

# Bare-metal Docker path only (iotstack otbr docker) -- USB Thread radio
# identification. Find values with: udevadm info /dev/ttyACM0
# DONGLE_VENDOR=
# DONGLE_PRODUCT=
# DONGLE_SERIAL=
# DONGLE_SYMLINK=ttyTHREAD
# BAUD_RATE=460800
