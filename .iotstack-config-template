# iotstack configuration
# Copy this to ~/.iotstack/config and configure your password manager

[password-manager]
# Which password manager to use: bitwarden, pass, 1password, keepassxc, pears
provider = bitwarden

# ── Bitwarden Configuration ─────────────────────────────────────────────────
# Requirements: bw CLI installed (npm install -g @bitwarden/cli)
# Secrets stored as: iotstack/<role>/<secret-type>
# Example: iotstack/bleproxy/ota_password
#
# [bitwarden]
# vault = iotstack  # Optional: specific vault name

# ── pass Configuration ──────────────────────────────────────────────────────
# Requirements: pass installed (brew install pass / apt install pass)
# Secrets stored in: ~/.password-store/iotstack/<role>/<secret-type>
# Example: ~/.password-store/iotstack/bleproxy/ota_password
#
# [pass]
# # No additional config needed - uses standard pass paths

# ── 1Password Configuration ─────────────────────────────────────────────────
# Requirements: op CLI installed (brew install 1password-cli / https://developer.1password.com/docs/cli/)
# Secrets stored as: iotstack_<role>_<secret-type>
# Example: iotstack_bleproxy_ota_password
#
# [1password]
# vault = iotstack  # Optional: specific vault name
# account = myaccount.1password.com  # Optional: specific account

# ── KeePassXC Configuration ─────────────────────────────────────────────────
# Requirements: keepassxc-cli installed
# Note: Complex setup - requires database path and master password
# Not recommended unless you have existing KeePassXC setup
#
# [keepassxc]
# database = /path/to/database.kdbx
# password = your-master-password  # Or use KEEPASSXC_PASSWORD env var

# ── Pears Pass Configuration ────────────────────────────────────────────────
# Requirements: Pears CLI installed (https://pass.pears.com/)
# Secrets stored in Pears vault
#
# [pears]
# # Configuration depends on Pears setup
