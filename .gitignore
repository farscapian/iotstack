*secret*
archive/
resources/esp32projects/  # Local clones of reference projects (not part of build)
**/.temp-rename-*.yaml
**/.temp-api-key-*.yaml
.esphome/
yamls/.esphome/
yamls/iotstack_partition_table.csv  # Symlink to ~/.iotstack/iotstack_partition_table.csv (generated)
.iotstack/  # Generated artifacts (partition tables, logs, caches)
legacy/ # old yamls and other stuff that is useful but no longer considered modern

# Exception: allow documentation and components (not actual secrets)
!docs/secrets.md
!docs/help/iotstack-secret.txt
!docs/help/iotstack-secret-detailed.txt
!docs/help/iotstack-rotate-secrets.txt
!docs/help/iotstack-rotate-secrets-detailed.txt
!scripts/iotstack-secrets
!scripts/rotate-secrets
!scripts/ensure-integration-secrets.sh

# Exception: allow external_components and scripts (not secrets)
!external_components/
!external_components/nvs_secrets/
!external_components/nvs_secrets/**
!external_components/nvs_ota_password/
!external_components/nvs_ota_password/**
!external_components/nvs_writer/
!external_components/nvs_writer/**
!yamls/external_components/
!yamls/external_components/nvs_secrets/
!yamls/external_components/nvs_secrets/**
!yamls/external_components/nvs_ota_password/
!yamls/external_components/nvs_ota_password/**
!yamls/external_components/nvs_writer/
!yamls/external_components/nvs_writer/**
!scripts/write-nvs-secrets.sh
!scripts/iotstack-secrets
!scripts/rotate-secrets__pycache__/

# Python bytecode caches (ESPHome external_components codegen)
__pycache__/
*.pyc
