#!/usr/bin/env bash
# iotstack-secrets: Interface to retrieve secrets from pass password manager
# All secrets are stored in ~/.iotstack/.pass
#
# Usage:
#   iotstack-secrets get <role> <secret-type> [version]
#
# Example:
#   iotstack-secrets get bleproxy ota_password       # Get current password
#   iotstack-secrets get bleproxy ota_password 0     # Get versioned password

set -euo pipefail

CONFIG_FILE="${HOME}/.iotstack/config"
PASS_STORE="${HOME}/.iotstack/.pass"

# ── Load configuration ──────────────────────────────────────────────────────
load_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "ERROR: Config file not found: $CONFIG_FILE" >&2
    echo "Run: ./setup.sh" >&2
    exit 1
  fi

  if [[ ! -d "$PASS_STORE" ]]; then
    echo "ERROR: Pass store not found: $PASS_STORE" >&2
    echo "Run: ./setup.sh" >&2
    exit 1
  fi
}

# ── Get secret from pass ────────────────────────────────────────────────────
get_secret() {
  local role="$1"
  local secret_type="$2"
  local version="${3:-}"

  # Build path: iotstack/bleproxy/ota_password or iotstack/bleproxy/ota_password_v1
  local secret_path="iotstack/${role}/${secret_type}"
  [[ -n "$version" ]] && secret_path="${secret_path}_v${version}"

  # Retrieve from pass using custom store directory
  export PASSWORD_STORE_DIR="$PASS_STORE"
  pass show "$secret_path" 2>/dev/null || return 1
}

# ── Main command dispatcher ─────────────────────────────────────────────────

case "${1:-help}" in
  get)
    if [[ $# -lt 3 ]]; then
      echo "Usage: iotstack-secrets get <role> <secret-type> [version]" >&2
      exit 1
    fi
    load_config
    get_secret "$2" "$3" "${4:-}" || exit 1
    ;;

  *)
    echo "Usage:"
    echo "  iotstack-secrets get <role> <secret-type> [version]"
    echo
    echo "Examples:"
    echo "  iotstack-secrets get bleproxy ota_password       # Current password"
    echo "  iotstack-secrets get bleproxy ota_password 0     # Versioned (v0)"
    echo
    echo "Password store: ${PASS_STORE}"
    exit 1
    ;;
esac
