#!/usr/bin/env bash
# iotstack-secrets: Unified interface to retrieve secrets from any password manager
# Supports: bitwarden, pass, 1password, keepassxc
#
# Usage:
#   iotstack-secrets get <role> <secret-type> [version]
#   iotstack-secrets list <role>
#   iotstack-secrets set <role> <secret-type> <value> [--sync]
#
# Configuration: ~/.iotstack/config

set -euo pipefail

CONFIG_FILE="${HOME}/.iotstack/config"
PROVIDER=""
VAULT=""
PATH_FORMAT=""

# ── Load configuration ──────────────────────────────────────────────────────
load_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "ERROR: Config file not found: $CONFIG_FILE" >&2
    echo "Run: iotstack setup-secrets" >&2
    exit 1
  fi

  # Parse config file for [password-manager] section
  local in_section=false
  while IFS='=' read -r key value; do
    key="${key//[[:space:]]/}"
    value="${value//[[:space:]]/}"

    [[ "$key" == "[password-manager]" ]] && in_section=true && continue
    [[ "$key" == "["* ]] && in_section=false && continue

    if [[ "$in_section" == true ]]; then
      case "$key" in
        provider) PROVIDER="$value" ;;
        vault) VAULT="$value" ;;
        path_format) PATH_FORMAT="$value" ;;
      esac
    fi
  done < "$CONFIG_FILE"

  if [[ -z "$PROVIDER" ]]; then
    echo "ERROR: password-manager provider not configured in $CONFIG_FILE" >&2
    exit 1
  fi
}

# ── Password Manager Implementations ────────────────────────────────────────

get_secret_bitwarden() {
  local role="$1"
  local secret_type="$2"
  local version="${3:-}"

  # Build item name: iotstack/bleproxy/ota_password or iotstack/bleproxy/ota_password_v1
  local item_name="iotstack/${role}/${secret_type}"
  [[ -n "$version" ]] && item_name="${item_name}_v${version}"

  if [[ -z "$VAULT" ]]; then
    bw item get "$item_name" --fields password 2>/dev/null || return 1
  else
    bw item get "$item_name" --vault "$VAULT" --fields password 2>/dev/null || return 1
  fi
}

get_secret_pass() {
  local role="$1"
  local secret_type="$2"
  local version="${3:-}"

  # Build path: iotstack/bleproxy/ota_password or iotstack/bleproxy/ota_password_v1
  local secret_path="iotstack/${role}/${secret_type}"
  [[ -n "$version" ]] && secret_path="${secret_path}_v${version}"

  pass show "$secret_path" 2>/dev/null || return 1
}

get_secret_1password() {
  local role="$1"
  local secret_type="$2"
  local version="${3:-}"

  # Item name: iotstack_bleproxy_ota_password or iotstack_bleproxy_ota_password_v1
  local item_id="iotstack_${role}_${secret_type}"
  [[ -n "$version" ]] && item_id="${item_id}_v${version}"

  if [[ -z "$VAULT" ]]; then
    op item get "$item_id" --fields password 2>/dev/null || return 1
  else
    op item get "$item_id" --vault "$VAULT" --fields password 2>/dev/null || return 1
  fi
}

get_secret_keepassxc() {
  local role="$1"
  local secret_type="$2"
  local version="${3:-}"

  # KeePassXC requires database and entry path
  # Path: iotstack/bleproxy/ota_password or iotstack/bleproxy/ota_password_v1
  local entry_path="iotstack/${role}/${secret_type}"
  [[ -n "$version" ]] && entry_path="${entry_path}_v${version}"

  # This requires kpcli or keepassxc-cli
  if command -v keepassxc-cli &>/dev/null; then
    # Note: This is complex and requires database path - user must configure
    echo "ERROR: KeePassXC CLI integration requires manual configuration" >&2
    return 1
  else
    echo "ERROR: keepassxc-cli not found" >&2
    return 1
  fi
}

# ── Main command dispatcher ─────────────────────────────────────────────────

case "${1:-help}" in
  get)
    if [[ $# -lt 3 ]]; then
      echo "Usage: iotstack-secrets get <role> <secret-type> [version]" >&2
      exit 1
    fi
    load_config
    get_secret_"$PROVIDER" "$2" "$3" "${4:-}" || exit 1
    ;;

  set)
    if [[ $# -lt 4 ]]; then
      echo "Usage: iotstack-secrets set <role> <secret-type> <value> [--sync]" >&2
      exit 1
    fi
    echo "ERROR: set command not yet implemented" >&2
    exit 1
    ;;

  list)
    if [[ $# -lt 2 ]]; then
      echo "Usage: iotstack-secrets list <role>" >&2
      exit 1
    fi
    echo "ERROR: list command not yet implemented" >&2
    exit 1
    ;;

  *)
    echo "Usage:"
    echo "  iotstack-secrets get <role> <secret-type> [version]"
    echo "  iotstack-secrets set <role> <secret-type> <value>"
    echo "  iotstack-secrets list <role>"
    echo
    echo "Supported password managers: bitwarden, pass, 1password, keepassxc"
    exit 1
    ;;
esac
