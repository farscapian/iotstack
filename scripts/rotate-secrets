#!/bin/bash
# rotate-secrets: Rotate device secrets (OTA password, WiFi creds, etc.) via USB or network
#
# Usage:
#   rotate-secrets --mode usb <device_role> <new_password>
#   rotate-secrets --mode network <device_role> <new_password>
#
# Example:
#   # Update bleproxy OTA password via USB (requires devices to be plugged in)
#   rotate-secrets --mode usb bleproxy "newPassword123"
#
#   # Update bleproxy OTA password over network (to all discovered devices)
#   rotate-secrets --mode network bleproxy "newPassword123"
#
#   # Rotate WiFi credentials over network
#   rotate-secrets --mode network --wifi-ssid "NewSSID" --wifi-password "NewPW"

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$PROJECT_DIR/setup.sh" 2>/dev/null || true

# Colors
RED='\033[0;31m'
GRN='\033[0;32m'
YLW='\033[0;33m'
BLU='\033[0;34m'
RST='\033[0m'

err()  { echo -e "${RED}[ERROR]${RST} $*" >&2; exit 1; }
ok()   { echo -e "${GRN}[OK]${RST} $*"; }
info() { echo -e "${YLW}[INFO]${RST} $*"; }
debug() { echo -e "${BLU}[DEBUG]${RST} $*"; }

# Defaults
MODE="network"  # usb or network
DEVICE_ROLE=""
NEW_PASSWORD=""
WIFI_SSID=""
WIFI_PASSWORD=""
THREAD_TLV=""
DEVICES=()

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode)
      MODE="$2"
      shift 2
      ;;
    --wifi-ssid)
      WIFI_SSID="$2"
      shift 2
      ;;
    --wifi-password)
      WIFI_PASSWORD="$2"
      shift 2
      ;;
    --thread-tlv)
      THREAD_TLV="$2"
      shift 2
      ;;
    --device)
      DEVICES+=("$2")
      shift 2
      ;;
    -h|--help)
      echo "Usage: rotate-secrets [options] <role> [new_password]"
      echo ""
      echo "Options:"
      echo "  --mode {usb|network}    Update method (default: network)"
      echo "  --wifi-ssid SSID        Update WiFi SSID"
      echo "  --wifi-password PW      Update WiFi password"
      echo "  --device MAC            Specific device MAC (USB mode)"
      echo "  --help                  Show this help"
      echo ""
      echo "Examples:"
      echo "  # Rotate OTA password over network"
      echo "  rotate-secrets --mode network bleproxy 'newPassword123'"
      echo ""
      echo "  # Update WiFi credentials over network"
      echo "  rotate-secrets --mode network --wifi-ssid 'NewSSID' --wifi-password 'NewPW'"
      echo ""
      echo "  # Update specific device via USB"
      echo "  rotate-secrets --mode usb --device 1af95c bleproxy 'newPassword123'"
      exit 0
      ;;
    *)
      if [[ -z "$DEVICE_ROLE" ]]; then
        DEVICE_ROLE="$1"
      elif [[ -z "$NEW_PASSWORD" ]]; then
        NEW_PASSWORD="$1"
      fi
      shift
      ;;
  esac
done

# Validate mode
[[ "$MODE" != "usb" && "$MODE" != "network" ]] && err "Invalid mode: $MODE (use 'usb' or 'network')"

# ── Update role secret in pass store ─────────────────────────────────────
if [[ -n "$NEW_PASSWORD" ]]; then
  info "Updating role secret in pass store"

  PASS_PATH="iotstack/roles/$DEVICE_ROLE/ota_password"

  # Store password twice for confirmation (pass requirement)
  { echo "$NEW_PASSWORD"; echo "$NEW_PASSWORD"; } | pass insert -f "$PASS_PATH" 2>/dev/null || \
    err "Failed to update pass store at $PASS_PATH"

  ok "Role secret updated: $PASS_PATH"
fi

# ── USB Mode: Update devices via serial ──────────────────────────────────
if [[ "$MODE" == "usb" ]]; then
  info "USB mode: Looking for connected devices"

  if [[ ${#DEVICES[@]} -eq 0 ]]; then
    # Auto-detect USB devices
    DEVICES=($(ls /dev/ttyACM* 2>/dev/null || true))
    [[ ${#DEVICES[@]} -eq 0 ]] && err "No USB devices found. Connect devices or specify with --device"
  fi

  for device in "${DEVICES[@]}"; do
    info "Updating $device"

    # Get device MAC from device info (requires custom component that exposes it)
    # For now, require manual specification or extract from device
    # This would need enhancement to query device info first

    # TODO: implement USB device enumeration to get MAC address
    err "USB mode not fully implemented yet - requires device discovery mechanism"
  done
fi

# ── Network Mode: Update devices via API ─────────────────────────────────
if [[ "$MODE" == "network" ]]; then
  info "Network mode: Discovering devices via mDNS"

  # Discover devices using avahi-browse
  DISCOVERED=$(avahi-browse -t -r _esphomelib._tcp 2>/dev/null | grep "^=" | awk '{print $4}' | sort -u || true)

  if [[ -z "$DISCOVERED" ]]; then
    err "No ESPHome devices found on network"
  fi

  # Build update payload
  declare -A NVS_DATA
  [[ -n "$WIFI_SSID" ]] && NVS_DATA[wifi_ssid]="$WIFI_SSID"
  [[ -n "$WIFI_PASSWORD" ]] && NVS_DATA[wifi_password]="$WIFI_PASSWORD"
  [[ -n "$THREAD_TLV" ]] && NVS_DATA[thread_tlv]="$THREAD_TLV"
  [[ -n "$NEW_PASSWORD" ]] && NVS_DATA[ota_password]="$NEW_PASSWORD"

  [[ ${#NVS_DATA[@]} -eq 0 ]] && err "No secrets specified to rotate"

  # For each discovered device
  for device_name in $DISCOVERED; do
    info "Processing device: $device_name"

    # Get device IP via mDNS
    DEVICE_IP=$(avahi-browse -t -r _esphomelib._tcp 2>/dev/null | \
      grep "$device_name" | grep "address =" | awk '{print $NF}' | head -1)

    if [[ -z "$DEVICE_IP" ]]; then
      echo -e "${YLW}[SKIP]${RST} Could not resolve $device_name" >&2
      continue
    fi

    # Build JSON payload for NVS update
    JSON_PAYLOAD="{"
    first=true
    for key in "${!NVS_DATA[@]}"; do
      if [[ "$first" == true ]]; then
        first=false
      else
        JSON_PAYLOAD="$JSON_PAYLOAD,"
      fi
      JSON_PAYLOAD="$JSON_PAYLOAD\"$key\":\"${NVS_DATA[$key]}\""
    done
    JSON_PAYLOAD="$JSON_PAYLOAD}"

    debug "Payload: $JSON_PAYLOAD"

    # Call API endpoint on device
    # NOTE: This requires nvs_writer component and custom API service
    # API endpoint: POST /api/nvs_update with JSON body

    RESPONSE=$(curl -s -X POST \
      -H "Content-Type: application/json" \
      -d "$JSON_PAYLOAD" \
      "http://$DEVICE_IP:8266/api/nvs_update" 2>/dev/null || echo "FAILED")

    if [[ "$RESPONSE" == "FAILED" ]]; then
      echo -e "${YLW}[WARN]${RST} Failed to reach $device_name ($DEVICE_IP)" >&2
    else
      ok "Updated $device_name ($DEVICE_IP)"
    fi
  done
fi

ok "Secret rotation complete"
