#!/bin/bash
# unmount-secrets: Safely unmount and erase RAM-based secrets

set -euo pipefail

SECRETS_MOUNT="${HOME}/.iotstack/secrets"

err() { echo "[ERROR] $*" >&2; exit 1; }
ok() { echo "[OK] $*"; }

if ! mount | grep -q "$SECRETS_MOUNT"; then
  echo "Secrets tmpfs not mounted."
  exit 0
fi

echo "Unmounting secrets tmpfs (all data will be erased)..."
sudo umount "$SECRETS_MOUNT"

ok "Secrets unmounted and erased from memory"
