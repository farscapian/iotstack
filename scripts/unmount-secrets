#!/bin/bash
# unmount-secrets: Unmount encrypted secrets (no sudo needed)

set -euo pipefail

SECRETS_MOUNT="${HOME}/.iotstack/secrets"

err() { echo "[ERROR] $*" >&2; exit 1; }
ok() { echo "[OK] $*"; }

if ! mount | grep -q "gocryptfs.*$SECRETS_MOUNT"; then
  echo "Secrets not mounted."
  exit 0
fi

echo "Unmounting encrypted secrets..."
fusermount -u "$SECRETS_MOUNT" || err "Failed to unmount. Try: fusermount -uz $SECRETS_MOUNT"

ok "Secrets unmounted (encrypted filesystem locked)"
