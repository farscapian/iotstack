#!/bin/bash
# mount-secrets: Mount user-land encrypted filesystem with gocryptfs
# This keeps secrets encrypted at rest, decrypted only in user-space FUSE mount
# No sudo required, private to current user, automatic cleanup on unmount

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_MOUNT="${HOME}/.iotstack/secrets"
SECRETS_ENCRYPTED="${HOME}/.iotstack/secrets-encrypted"
SECRETS_YAML="${SECRETS_MOUNT}/secrets.yaml"
PASS_STORE="${HOME}/.iotstack/.pass"

err() { echo "[ERROR] $*" >&2; exit 1; }
ok() { echo "[OK] $*"; }
warn() { echo "[WARN] $*"; }

# Check if gocryptfs is installed
if ! command -v gocryptfs &>/dev/null; then
  err "gocryptfs not found. Install with:
  Ubuntu/Debian: sudo apt install gocryptfs
  macOS: brew install gocryptfs
  Or: https://github.com/rfjakob/gocryptfs/releases"
fi

# Check if already mounted
if mount | grep -q "gocryptfs.*$SECRETS_MOUNT"; then
  warn "Secrets already mounted at $SECRETS_MOUNT"
  exit 0
fi

# Create encrypted storage directory if needed
mkdir -p "$SECRETS_ENCRYPTED"
mkdir -p "$SECRETS_MOUNT"

# Initialize gocryptfs if not already initialized
if [[ ! -f "$SECRETS_ENCRYPTED/gocryptfs.conf" ]]; then
  echo "[INFO] Initializing encrypted secrets vault..."

  # Generate strong password and store in pass
  gocryptfs_password=$(openssl rand -base64 32)
  export PASSWORD_STORE_DIR="$PASS_STORE"

  # Store password in pass (used for mounting encrypted vault)
  if ! echo "$gocryptfs_password" | pass insert -f "iotstack/gocryptfs/password" >/dev/null 2>&1; then
    err "Failed to store gocryptfs password in pass. Ensure pass is initialized."
  fi

  # Initialize gocryptfs non-interactively with password
  init_log=$(mktemp)
  echo "$gocryptfs_password" | gocryptfs -init -password - "$SECRETS_ENCRYPTED" >"$init_log" 2>&1
  init_status=$?
  init_output=$(cat "$init_log")
  rm -f "$init_log"

  if [[ $init_status -ne 0 ]]; then
    err "Failed to initialize gocryptfs:

$init_output

Encrypted storage: $SECRETS_ENCRYPTED
Mount point: $SECRETS_MOUNT

Try manually:
  gocryptfs -init $SECRETS_ENCRYPTED"
  fi

  ok "Generated and stored gocryptfs password in pass"
fi

# Retrieve gocryptfs password from pass
export PASSWORD_STORE_DIR="$PASS_STORE"
gocryptfs_password=$(pass show "iotstack/gocryptfs/password" 2>/dev/null) || \
  err "Could not retrieve gocryptfs password from pass"

# Mount encrypted filesystem to plaintext mount point
echo "[INFO] Mounting encrypted secrets (user-land FUSE)..."
mount_log=$(mktemp)
echo "$gocryptfs_password" | gocryptfs -password - "$SECRETS_ENCRYPTED" "$SECRETS_MOUNT" >"$mount_log" 2>&1
mount_status=$?
mount_output=$(cat "$mount_log")
rm -f "$mount_log"

if [[ $mount_status -ne 0 ]]; then
  err "Failed to mount gocryptfs:

$mount_output

Mount point: $SECRETS_MOUNT
Encrypted store: $SECRETS_ENCRYPTED

Try manually:
  gocryptfs -password - $SECRETS_ENCRYPTED $SECRETS_MOUNT"
fi

# Generate secrets.yaml from pass
echo "[INFO] Populating secrets from pass..."

cat > "$SECRETS_YAML" << 'EOF'
# secrets.yaml — GENERATED FROM PASS, USER-LAND ENCRYPTED
# This file is decrypted in a FUSE mount by gocryptfs
# Encryption key is protected by your system keyring/password
# File will be erased when mount is unmounted

EOF

# Verify pass is initialized
if [[ ! -d "$PASS_STORE/.git" ]]; then
  err "pass repository not initialized at $PASS_STORE
Run ./setup.sh to initialize pass"
fi

# Discover roles dynamically from yamls/ directory
declare -a roles=()
YAMLS_DIR="${SCRIPT_DIR}/../yamls"

for yaml_file in "$YAMLS_DIR"/*.yaml; do
  if [[ -f "$yaml_file" ]]; then
    role=$(basename "$yaml_file" .yaml)
    roles+=("$role")
  fi
done

# Extract all secrets from pass and add them to secrets.yaml
declare -a secret_types=("ota_password" "api_encryption_key")

for role in "${roles[@]}"; do
  for secret_type in "${secret_types[@]}"; do
    secret_path="iotstack/${role}/${secret_type}"
    if pass show "$secret_path" &>/dev/null 2>&1; then
      secret_value=$(pass show "$secret_path" 2>/dev/null | head -1)
      echo "${role}_${secret_type}: \"$secret_value\"" >> "$SECRETS_YAML"
    fi
  done
done

# Ensure YAML is readable but not world-accessible
chmod 600 "$SECRETS_YAML"

ok "Secrets mounted to user-land encrypted filesystem"
ok "Decrypted at: $SECRETS_MOUNT"
ok "Encrypted storage: $SECRETS_ENCRYPTED"
echo
echo "Security properties:"
echo "  • Encryption key: Protected by your system keyring"
echo "  • User-space mount: No sudo required"
echo "  • Private to you: FUSE mount only accessible by your user"
echo "  • Plaintext in mount: Decrypted in memory only while mounted"
echo
echo "To unmount and encrypt:"
echo "  fusermount -u ${SECRETS_MOUNT}"
echo
echo "Mounted at:"
echo "  ${SECRETS_MOUNT}"
