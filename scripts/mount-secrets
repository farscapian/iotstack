#!/bin/bash
# mount-secrets: Mount secrets into tmpfs (RAM only)
# This keeps secrets.yaml in memory only, never written to disk unencrypted

set -euo pipefail

SECRETS_MOUNT="${HOME}/.iotstack/secrets"
SECRETS_YAML="${SECRETS_MOUNT}/secrets.yaml"
PASS_STORE="${HOME}/.iotstack/.pass"

err() { echo "[ERROR] $*" >&2; exit 1; }
ok() { echo "[OK] $*"; }
warn() { echo "[WARN] $*"; }

# Check if already mounted
if mount | grep -q "tmpfs.*${SECRETS_MOUNT}"; then
  warn "Secrets tmpfs already mounted at $SECRETS_MOUNT"
  exit 0
fi

echo "[INFO] Mounting secrets to RAM (tmpfs)..."

# Create mount point
mkdir -p "$SECRETS_MOUNT"

# Mount tmpfs (requires sudo)
sudo mount -t tmpfs -o size=16M tmpfs "$SECRETS_MOUNT" || err "Failed to mount tmpfs"

ok "Secrets mounted to RAM at $SECRETS_MOUNT"

# Generate secrets.yaml from pass
echo "[INFO] Populating secrets from pass..."

cat > "$SECRETS_YAML" << 'EOF'
# secrets.yaml — GENERATED FROM PASS, RAM-ONLY TMPFS
# This file is decrypted in RAM only, never on disk
# File will be erased when mount is unmounted or on reboot

EOF

# Verify pass is initialized
if [[ ! -f "$PASS_STORE/.gpg-id" ]]; then
  err "pass repository not initialized at $PASS_STORE
Run ./setup.sh to initialize pass"
fi

# Discover roles dynamically from yamls/ directory
declare -a roles=()
YAMLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/yamls"

for yaml_file in "$YAMLS_DIR"/*.yaml; do
  if [[ -f "$yaml_file" ]]; then
    role=$(basename "$yaml_file" .yaml)
    roles+=("$role")
  fi
done

# Extract all secrets from pass and add them to secrets.yaml
declare -a secret_types=("ota_password" "api_encryption_key")

for role in "${roles[@]}"; do
  for secret_type in "${secret_types[@]}"; do
    secret_path="iotstack/${role}/${secret_type}"
    export PASSWORD_STORE_DIR="$PASS_STORE"
    if pass show "$secret_path" &>/dev/null 2>&1; then
      secret_value=$(pass show "$secret_path" 2>/dev/null | head -1)
      echo "${role}_${secret_type}: \"$secret_value\"" >> "$SECRETS_YAML"
    fi
  done
done

# Ensure YAML is readable but not world-accessible
chmod 600 "$SECRETS_YAML"

ok "Secrets populated in tmpfs"
echo
echo "Security properties:"
echo "  • Storage: 16MB tmpfs (RAM only)"
echo "  • Encryption: Encrypted in pass (at rest)"
echo "  • Decryption: In RAM only while mounted"
echo "  • Erasure: Complete on unmount or reboot"
echo
echo "To unmount and erase:"
echo "  sudo umount ${SECRETS_MOUNT}"
echo
echo "Mounted at:"
echo "  ${SECRETS_MOUNT}"
