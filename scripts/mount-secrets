#!/bin/bash
# mount-secrets: Mount encrypted secrets into RAM-only tmpfs
# This keeps secrets.yaml in memory only, never written to disk unencrypted

set -euo pipefail

SECRETS_MOUNT="${HOME}/.iotstack/secrets"
SECRETS_YAML="${SECRETS_MOUNT}/secrets.yaml"
PASS_STORE="${HOME}/.iotstack/.pass"

err() { echo "[ERROR] $*" >&2; exit 1; }
ok() { echo "[OK] $*"; }
warn() { echo "[WARN] $*"; }

# Check if tmpfs is already mounted
if mount | grep -q "$SECRETS_MOUNT"; then
  warn "Secrets tmpfs already mounted at $SECRETS_MOUNT"
  exit 0
fi

# Create mount point
mkdir -p "$SECRETS_MOUNT"

# Mount tmpfs (16MB should be plenty for secrets)
echo "Mounting tmpfs at $SECRETS_MOUNT (16MB, memory-only)..."
sudo mount -t tmpfs -o size=16M tmpfs "$SECRETS_MOUNT"

if [[ ! -d "$PASS_STORE" ]]; then
  err "Pass store not found at $PASS_STORE. Run ./setup.sh first."
fi

# Generate secrets.yaml from pass into tmpfs
echo "Generating secrets.yaml from pass store..."
export PASSWORD_STORE_DIR="$PASS_STORE"

cat > "$SECRETS_YAML" << 'EOF'
# secrets.yaml — GENERATED FROM PASS, MEMORY-ONLY
# This file exists ONLY in RAM (tmpfs at ~/.iotstack/secrets)
# It will be completely erased on reboot or unmount.
# Do NOT edit this file directly — use pass instead:
#   pass insert iotstack/<role>/<secret-type>

EOF

# Extract all secrets from pass and add them to secrets.yaml
declare -a roles=("bleproxy" "mmwave" "threadrouter" "ledstrip" "sendspin")
declare -a secret_types=("ota_password" "api_encryption_key")

for role in "${roles[@]}"; do
  for secret_type in "${secret_types[@]}"; do
    secret_path="iotstack/${role}/${secret_type}"
    if pass show "$secret_path" &>/dev/null 2>&1; then
      secret_value=$(pass show "$secret_path" 2>/dev/null | head -1)
      echo "${role}_${secret_type}: \"$secret_value\"" >> "$SECRETS_YAML"
    fi
  done
done

# Ensure YAML is readable but not world-accessible
chmod 600 "$SECRETS_YAML"

ok "Secrets mounted to RAM at $SECRETS_MOUNT"
ok "secrets.yaml generated (memory-only)"
ok "Will be erased on unmount or reboot"
echo
echo "To use with iotstack:"
echo "  export IOTSTACK_SECRETS=${SECRETS_MOUNT}"
echo
echo "To unmount when done:"
echo "  sudo umount ${SECRETS_MOUNT}"
