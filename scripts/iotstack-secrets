#!/usr/bin/env bash
# iotstack secret: Manage encrypted secrets (OTA passwords, API keys)
# Secrets are stored GPG-encrypted under IOTSTACK_HOME/.pass (default
# ~/.iotstack/.pass), namespaced by the active -env= environment.
#
# Usage:
#   iotstack secret get <role> <ota|api> [version]
#   iotstack secret set <role> <ota|api> <value>
#
# Examples:
#   iotstack secret get bleproxy ota              # Get current OTA password
#   iotstack secret get bleproxy api              # Get current API key
#   iotstack secret get bleproxy ota 0            # Get versioned (v0)
#   iotstack secret set bleproxy ota "newPass"    # Set (auto-versions old)
#   iotstack secret set bleproxy api "newKey"     # Set (auto-versions old)

set -euo pipefail

_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/config.sh
source "${_SCRIPT_DIR}/config.sh"

# Kept as an alias so the rest of this file (verify_pass, usage text) reads
# unchanged -- config.sh already exports PASSWORD_STORE_DIR/GNUPGHOME.
PASS_STORE="$PASSWORD_STORE_DIR"

err() { echo "ERROR: $*" >&2; exit 1; }
ok() { echo "[OK] $*"; }

# -- Verify pass is initialized ----------------------------------------------
verify_pass() {
  if [[ ! -d "$PASS_STORE" ]]; then
    err "Pass store not found: $PASS_STORE. Run: ./setup.sh"
  fi

  if [[ ! -f "$PASS_STORE/.gpg-id" ]]; then
    err "Pass repository not initialized. Run: ./setup.sh"
  fi
}

# -- Map short names to full secret types ------------------------------------
expand_secret_type() {
  local short_name="$1"
  case "$short_name" in
    ota)  echo "ota_password" ;;
    api)  echo "api_encryption_key" ;;
    *)    err "Unknown secret type: $short_name. Use 'ota' or 'api'" ;;
  esac
}

# -- Get secret from pass ----------------------------------------------------
get_secret() {
  local role="$1"
  local secret_type="$2"  # ota_password or api_encryption_key
  local version="${3:-}"

  # Build key: ota_password or ota_password_v1; iotstack_pass_role_read
  # resolves it under the env-scoped path, falling back to (and migrating) a
  # legacy unscoped entry.
  local key="$secret_type"
  [[ -n "$version" ]] && key="${key}_v${version}"

  iotstack_pass_role_read "$role" "$key" 2>/dev/null || return 1
}

# -- Set secret with auto-versioning -----------------------------------------
set_secret() {
  local role="$1"
  local secret_type="$2"  # ota_password or api_encryption_key
  local new_value="$3"

  if [[ -z "$new_value" ]]; then
    err "Value cannot be empty"
  fi

  local current_path
  current_path="$(iotstack_pass_role_path "$role" "$secret_type")"
  local next_version=0

  # Check if a current value exists (migrating a legacy unscoped one forward
  # to $current_path first, if that's the only place it's found) and archive it.
  local current_value
  if current_value="$(iotstack_pass_role_read "$role" "$secret_type" 2>/dev/null)"; then
    # Find highest version number
    if pass ls "${current_path}_v" &>/dev/null 2>&1; then
      next_version=$(pass ls "${current_path}_v" 2>/dev/null | \
        sed "s/.*_v//" | sort -n | tail -1)
      next_version=$((next_version + 1))
    fi

    # Archive old value
    local versioned_path="${current_path}_v${next_version}"
    if ! echo "$current_value" | pass insert -f "$versioned_path" 2>&1; then
      err "Failed to archive old value at $versioned_path"
    fi
    ok "Archived old value as ${secret_type}_v${next_version}"
  fi

  # Set new value
  if ! echo "$new_value" | pass insert -f "$current_path" 2>&1; then
    err "Failed to set $secret_type for $role"
  fi
  ok "Set $secret_type for $role"
}

# -- Main command dispatcher -------------------------------------------------

verify_pass

case "${1:-help}" in
  get)
    if [[ $# -lt 3 ]]; then
      echo "Usage: iotstack secret get <role> <ota|api> [version]" >&2
      exit 1
    fi
    secret_type=$(expand_secret_type "$3")
    get_secret "$2" "$secret_type" "${4:-}" || exit 1
    ;;

  set)
    if [[ $# -lt 4 ]]; then
      echo "Usage: iotstack secret set <role> <ota|api> <value>" >&2
      exit 1
    fi
    secret_type=$(expand_secret_type "$3")
    set_secret "$2" "$secret_type" "$4"
    ;;

  *)
    echo "Usage:"
    echo "  iotstack secret get <role> <ota|api> [version]"
    echo "  iotstack secret set <role> <ota|api> <value>"
    echo
    echo "Examples:"
    echo "  iotstack secret get bleproxy ota              # Get OTA password"
    echo "  iotstack secret get bleproxy api              # Get API key"
    echo "  iotstack secret get bleproxy ota 0            # Get archived (v0)"
    echo "  iotstack secret set bleproxy ota \"newPass\"   # Set OTA, version old"
    echo "  iotstack secret set bleproxy api \"newKey\"    # Set API, version old"
    echo
    echo "Secret types: ota (OTA password), api (API encryption key)"
    echo "Store: ${PASS_STORE}"
    exit 1
    ;;
esac
