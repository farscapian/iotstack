# Symlink to ~/.iotstack/otbr/ data home (local convenience; not shared)
.iotstack

# Legacy data dirs -- now live in ~/.iotstack/otbr/ but may still exist here
# from before migration (or from the earlier ~/.otbrstack/ layout)
cache/
artifacts/
logs/

test-vm/vm-disk.qcow2
test-vm/seed.iso
test-vm/uefi-vars.fd
test-vm/uefi-code.fd
test-vm/user-data.yaml
test-vm/test-vm-key
test-vm/test-vm-key.pub

# Syncthing conflict files
*.sync-conflict-*

# Active working env (may contain secrets); example *.env files are committed
*.env

# IDE / AI assistant
.vscode/
.claude/

# Python
__pycache__/
*.pyc
*.pyo
