# =============================================================================
# otbr -- environment variables
#
# Env files live in ~/.otbr/env/.  Copy this example and fill in your values:
#
#   cp .env.example ~/.otbr/env/$(hostname).env   # hostname-specific (priority)
#   cp .env.example ~/.otbr/env/.env              # generic fallback
#
# otbr looks for ~/.otbr/env/$(hostname).env first, then ~/.otbr/env/.env.
# Pass a different file explicitly with: otbr flash --env-file=PATH /dev/sdX
#
# The env file is sourced automatically -- no export or sudo -E needed.
# =============================================================================

# =============================================================================
# Device-specific settings -- set these per env file
# =============================================================================

# Device hostname written into cloud-init meta-data.
# Used for the Pi's /etc/hostname, mDNS name (<hostname>.local), and SSH config stub.
OTBR_HOSTNAME=otbr-raspi4

# Deploy python-matter-server on the device (WebSocket Matter controller, port 5580).
# Set to 0 to skip installation.  When enabled, Home Assistant can point its
# Matter integration at ws://<hostname>.local:5580 to control devices in this fabric.
DEPLOY_MATTER_SERVER=1

# Thread Active Operational Dataset TLV (hex string).
# Generate with: ot-ctl dataset init new && ot-ctl dataset active -x
# Or export from an existing Thread commissioner.
THREAD_DATASET_TLV="0e080000000000010000..."

# =============================================================================
# Network settings
# =============================================================================

# Wi-Fi credentials written into the cloud-init netplan config.
# wlan0 is used as fallback when eth0 is not present or link is down.
WIFI_SSID="YourNetworkName"
WIFI_PASSWORD="YourWiFiPassword"

# SSH public key injected into the Pi image via cloud-init.
# Grants SSH access to the ubuntu user.
SSH_PUBKEY=""

# UFW: space-separated list of CIDRs allowed to SSH into the device.
# Use /32 for individual hosts, or a subnet like 192.168.4.0/24.
# Leave empty to allow SSH from anywhere (not recommended for production).
# Example: SSH_MGMT_CIDRS="192.168.4.25/32 192.168.4.30/32"
SSH_MGMT_CIDRS=""

# =============================================================================
# Snap channels
# =============================================================================

# Snap channel for openthread-border-router (not on stable; use edge or beta).
OTBR_SNAP_CHANNEL="latest/edge"

# Snap channel for chip-tool (Matter commissioning CLI).
CHIP_TOOL_SNAP_CHANNEL="latest/stable"

# =============================================================================
# Development / performance options
# =============================================================================

# Skip SHA-256 verification of the downloaded Ubuntu image.
# Set to 1 only to save time when re-flashing with an already-verified image.
SKIP_IMAGE_VERIFICATION=0

# Skip git clone/fetch/pull operations during flash and on the Pi's first boot.
# When 1, all cached source is used as-is; no network git ops are attempted.
PULL_LATEST_REPOS=1

# Skip RCP Spinel firmware verification during first-boot.
# Set to 1 to bypass the probe when debugging issues unrelated to the RCP.
SKIP_RCP_VERIFY=0

# Skip the arm64 chroot during flash.
# The chroot runs apt-get upgrade + install + ESP-IDF toolchain (~5-15 min).
# When 1, all apt work is deferred to first-boot on the Pi; snap and RCP files
# are still pre-loaded so offline install works normally.
SKIP_CHROOT=0

# Optional HTTP/HTTPS proxy (e.g. a local Squid cache).
# Applied to apt AND git/curl on both the host and the Pi.
# Leave empty for direct internet access.
# Example: HTTP_PROXY="http://squid.local:3128"
HTTP_PROXY=""

# =============================================================================
# Home Assistant MQTT Discovery (optional)
# =============================================================================
# When MQTT_BROKER is set, the Pi registers with HA automatically via MQTT
# Discovery: restart/shutdown buttons, OTBR agent status, Thread role, uptime.
# Requires the HA Mosquitto add-on or an external MQTT broker.
# Leave MQTT_BROKER empty to disable.
MQTT_BROKER=""
MQTT_PORT=1883
# Credentials -- leave empty if your broker has no auth.
# With the HA Mosquitto add-on, a HA long-lived access token works as the
# password (MQTT_USER = your HA username, MQTT_PASSWORD = the token):
MQTT_USER=""
MQTT_PASSWORD=""
